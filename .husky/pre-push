#!/bin/sh
set -eu

if [ -n "${CI:-}" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "Direct pushes to main are blocked; use a pull request and merge queue." >&2
      exit 1
      ;;
  esac
  case "$local_ref" in
    refs/tags/v[0-9]*|refs/tags/zeroshot-python-v*)
      echo "Version tags are created only by the release workflows." >&2
      exit 1
      ;;
  esac
done

npm test
