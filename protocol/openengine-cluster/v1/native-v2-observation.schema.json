{
  "$defs": {
    "ActiveExecution": {
      "additionalProperties": false,
      "description": "One currently active graph-leaf execution.\n\n`execution` is the stable selector used by logs and attach. `node` is the graph-visible\nidentity that makes multiple simultaneous verifier executions obvious to a client.",
      "properties": {
        "execution": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "type": "string"
        },
        "mapIndices": {
          "description": "Zero-based map indices, outermost first; empty outside maps.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "node": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "type": "string"
        }
      },
      "required": [
        "execution",
        "node"
      ],
      "type": "object"
    },
    "AgentAttachEvent": {
      "description": "The closed public agent-attach progress algebra. This is the only representable shape:\nreasoning, tools, provider frames, usage, and session identifiers have no variant. `Working`\nand `Settled` are empty struct variants rather than bare units: serde's internally tagged enum\ndeserialization silently ignores unknown fields on a unit variant regardless of\n`deny_unknown_fields`, which would otherwise let an unrepresentable field ride along\nundetected on either of these two variants.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "working",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "maxLength": 16384,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
              "type": "string"
            },
            "type": {
              "const": "output",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "settled",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ControllerObservation": {
      "additionalProperties": false,
      "description": "Availability observed by a reader, separate from the run's durable status.",
      "properties": {
        "observedAt": {
          "description": "Time of this check, not the time the controller stopped.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ControllerState"
        }
      },
      "required": [
        "state",
        "observedAt"
      ],
      "type": "object"
    },
    "ControllerState": {
      "enum": [
        "lost",
        "unknown"
      ],
      "type": "string"
    },
    "DomainErrorData": {
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "ExhaustedLoop": {
      "additionalProperties": false,
      "description": "One completed exhausted loop visit, counted by the reducer rather than worker attempts.",
      "properties": {
        "completedIterations": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "mapIndices": {
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "node": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "type": "string"
        }
      },
      "required": [
        "node",
        "completedIterations"
      ],
      "type": "object"
    },
    "FailureContext": {
      "additionalProperties": false,
      "description": "The known runtime cause and recent recorded node failures are deliberately separate.\nRecorded failures are evidence; retries or parallel branches may have recovered from them.",
      "properties": {
        "exhaustedLoops": {
          "description": "Latest exhausted visit per loop node and map path.",
          "items": {
            "$ref": "#/$defs/ExhaustedLoop"
          },
          "maxItems": 5,
          "type": "array"
        },
        "incomplete": {
          "default": false,
          "type": "boolean"
        },
        "primary": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureDiagnostic"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FailureDiagnostic"
          },
          "maxItems": 5,
          "type": "array"
        },
        "verifiers": {
          "description": "Latest recorded result per verifier node and map path, oldest first.",
          "items": {
            "$ref": "#/$defs/FailureDiagnostic"
          },
          "maxItems": 5,
          "type": "array"
        }
      },
      "type": "object"
    },
    "FailureDiagnostic": {
      "additionalProperties": false,
      "description": "One recorded explanation, with an optional execution selector and retained log cursor.\nA missing cursor means there is no reference into the available durable history.",
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActiveExecution"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "maxLength": 16384,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "JsonRpcError": {
      "properties": {
        "code": {
          "format": "int64",
          "type": "integer"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainErrorData"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "JsonRpcErrorResponse": {
      "properties": {
        "error": {
          "$ref": "#/$defs/JsonRpcError"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "jsonrpc": {
          "type": "string"
        }
      },
      "required": [
        "jsonrpc",
        "error"
      ],
      "type": "object"
    },
    "JsonRpcNotification": {
      "properties": {
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RunWatchEventNotification"
        }
      },
      "required": [
