            "string",
            "null"
          ]
        },
        "successorRunId": {
          "description": "Successor already admitted from this run, if one exists.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "recoverable"
      ],
      "type": "object"
    }
