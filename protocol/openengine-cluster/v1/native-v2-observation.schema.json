              "anyOf": [
                {
                  "$ref": "#/$defs/FailureContext"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            "status": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Run-wide sum of provider-reported usage for every launched agent invocation.\n\n`complete` is false when at least one invocation did not report usable counters. Cache\ncounters are omitted when the provider does not expose them consistently.",
      "properties": {
        "cacheCreationInputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cacheReadInputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "complete"
      ],
      "type": "object"
    },
    "VectorId": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "type": "string"
    },
    "VectorSuspensionReason": {
      "enum": [
        "command",
        "wait"
      ],
      "type": "string"
    },
    "WorkspaceRecovery": {
      "additionalProperties": false,
      "description": "Public recovery state. It never contains credentials, workspace paths, or checkpoint bytes.",
      "properties": {
        "connectionRequirements": {
          "additionalProperties": false,
          "description": "Exact connection fields that the successor must resolve again.",
          "patternProperties": {
            "^[^\\u0000-\\u001f\\u007f-\\u009f]+$": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "recoverable": {
          "description": "Whether this run can admit a successor from retained workspace state.",
