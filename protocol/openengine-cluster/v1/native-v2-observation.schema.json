            }
          ]
        }
      },
      "type": "object"
    },
    "RunStatus": {
      "description": "Public run state. The closed phase variants make impossible combinations unrepresentable:\nadmitted runs have no execution, stopping means force was requested, and finished runs have\nexactly one terminal result and no active execution. Running/stopping report every active\nexecution rather than a single \"current worker\" slot.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "admitted",
              "type": "string"
            }
          },
          "required": [
            "phase"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activeExecutions": {
              "items": {
                "$ref": "#/$defs/ActiveExecution"
              },
              "type": "array"
            },
            "graphResult": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TerminalResult"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Recorded graph outcome while postmortem and finalization are still pending.\nOnly `Finished.terminalResult` determines the final run outcome."
            },
            "phase": {
              "const": "running",
              "type": "string"
            },
            "suspendRequested": {
              "type": "boolean"
            }
          },
          "required": [
            "phase",
            "activeExecutions"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activeExecutions": {
              "items": {
                "$ref": "#/$defs/ActiveExecution"
              },
              "type": "array"
            },
            "graphResult": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TerminalResult"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Recorded graph outcome retained while stopping finalization."
            },
            "phase": {
              "const": "stopping",
              "type": "string"
            }
          },
          "required": [
            "phase",
            "activeExecutions"
          ],
          "type": "object"
        },
        {
          "description": "Durable end of an attempt whose graph can continue in a successor.",
          "oneOf": [
            {
              "properties": {
                "createdAt": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                "node": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                  "type": "string"
                },
                "reason": {
                  "const": "command",
                  "type": "string"
                }
              },
              "required": [
                "reason",
                "node",
                "createdAt"
              ],
              "type": "object"
            },
            {
              "properties": {
                "createdAt": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                "node": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
                  "type": "string"
                },
                "reason": {
                  "const": "wait",
                  "type": "string"
                },
                "wait": {
                  "$ref": "#/$defs/RunWait"
                }
              },
              "required": [
                "reason",
                "node",
                "createdAt",
                "wait"
              ],
              "type": "object"
            }
          ],
          "properties": {
            "metadata": {
              "$ref": "#/$defs/RunMetadata",
              "default": {}
            },
            "phase": {
              "const": "suspended",
              "type": "string"
            }
          },
          "required": [
            "phase"
          ],
          "type": "object",
          "unevaluatedProperties": false
        },
        {
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "$ref": "#/$defs/RunMetadata",
              "default": {}
            },
            "phase": {
              "const": "finished",
              "type": "string"
            },
            "terminalResult": {
              "$ref": "#/$defs/TerminalResult"
            }
          },
          "required": [
            "phase",
            "terminalResult"
          ],
          "type": "object"
        }
      ]
    },
