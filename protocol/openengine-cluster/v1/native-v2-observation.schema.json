        "atCursor"
      ],
      "type": "object"
    },
    "RunMetadata": {
      "additionalProperties": false,
      "description": "Runtime-owned metadata accompanying terminal status and retained run history.",
      "properties": {
        "deliveryReceipt": {
          "description": "Confirmed native delivery evidence, independent of the graph's terminal output."
        },
