{
  "schemaVersion": 1,
  "verify": {
    "maxCyclomaticComplexity": 30,
    "maxFunctionLines": 300,
    "maxNesting": 5,
    "maxParameters": 8
  },
  "targets": {
    "exclude": [
      ".github/scripts/test-windows-host.ps1",
      "scripts/test-windows.ps1"
    ]
  },
  "documentation": {
    "bindings": [
      {
        "source": "zeroshot/src/native_v2_portable_controller.rs",
        "document": "docs/guides/runtime-environments.md"
      },
      {
        "source": "ui/src/api.ts",
        "document": "ui/README.md"
      },
      {
        "source": "ui/src/domain.ts",
        "document": "ui/README.md"
      },
      {
        "source": "ui/src/workflow-projection.ts",
        "document": "ui/README.md"
      },
      {
        "source": "ui/src/run-history.ts",
        "document": "ui/README.md"
      }
    ]
  }
}
