{
  "name": "@the-open-engine-company/zeroshot-repository",
  "version": "0.0.0-development",
  "private": true,
  "description": "Repository tooling for the Zeroshot native product.",
  "scripts": {
    "test": "node --test tests/tooling/*.test.js",
    "lint": "eslint .github/ci-path-classifier.js scripts/*.js npm/zeroshot/**/*.js tests/tooling/*.js commitlint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "protocol:check": "cargo run -p openengine-cluster-testkit --bin generate-cluster-protocol -- --check",
    "distribution:check": "node scripts/distribution.js check-repository",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "rust:docs": "RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps",
    "rust:check": "npm run rust:fmt && npm run rust:clippy && npm run rust:test && npm run rust:docs",
    "opcore:status": "opcore status --repo . --json",
    "opcore:scan": "opcore --repo . --json",
    "opcore:check": "node scripts/opcore-introduced-check.js",
    "opcore:check:staged": "node scripts/opcore-introduced-check.js --staged",
    "opcore:install:rust-metrics": "cargo install rust-code-analysis-cli --version 0.0.25 --locked",
    "opcore:graph:build": "opcore graph build --repo . --json",
    "opcore:graph:update": "opcore graph update --repo . --json",
    "opcore:measure": "opcore measure --repo . --json",
    "check": "npm run lint && npm test && npm run distribution:check && npm run protocol:check",
    "prepare": "husky"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "opcore": "0.2.1",
    "prettier": "^3.7.4"
  }
}
