        },
        {
          "name": "limit",
          "required": false,
          "schema": {
            "format": "uint32",
            "maximum": 100,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          }
        }
      ],
      "result": {
        "name": "runCheckpointsResult",
        "schema": {
          "$ref": "schema.json#/$defs/RunCheckpointsResult"
        }
      },
      "summary": "List retained node and atomic-group entry checkpoints",
      "x-subscription": false,
      "x-transport-requirements": {
        "inboundNotifications": false,
        "serverPush": false
      }
    },
    {
      "description": "Omitting from or selecting restart starts the graph at its root on the latest retained workspace. Selecting checkpoint restores the matching workspace and predecessor outputs and reruns the named node or atomic concurrent group. Original admission and delivery metadata remain fixed. Credentials are resolved again for the successor; provider sessions are not resumed.",
