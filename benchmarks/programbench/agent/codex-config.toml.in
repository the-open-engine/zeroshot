# Codex configuration used by every agent node (rendered per task image by bench/images.py).
# Isolation is enforced outside Codex: the container can only reach the model API host through the
# allowlist proxy, so Codex runs with full access inside the disposable container.
approval_policy = "never"
sandbox_mode = "danger-full-access"
# Hosted web search runs on OpenAI's side and would bypass the network allowlist.
web_search = "disabled"
check_for_update_on_startup = false

[analytics]
enabled = false

[feedback]
enabled = false

[history]
persistence = "none"

# Codex's shell snapshot re-exports the whole process environment into tool shells, bypassing the
# shell_environment_policy exclusions below; with it on, tool commands could read the API key
# (caught by the smoke test's KEY_VARS_VISIBLE probe). Tool shells start fresh instead.
[features]
shell_snapshot = false

# Codex memories could carry one thread's context into later "fresh" threads (for example from a
# builder into a checker). Every node starts from its prompt alone.
[memories]
generate_memories = false
use_memories = false

# Left unset, Codex marks /workspace trusted on first use and from then on loads AGENTS.md files
# and .codex/config.toml layers from the workspace into every node: a builder could instruct the
# checker, or undo settings in this file. Untrusted keeps every node on this configuration and its
# prompt alone; the explicit sandbox and approval settings above still apply.
[projects."/workspace"]
trust_level = "untrusted"

# Zeroshot starts Codex with a minimal environment. Tool commands must still see the task
# image's toolchain variables (CARGO_HOME, RUSTUP_HOME, ...) exactly as a plain shell in the
# image would, plus the non-interactive pager settings the upstream baseline used. Credentials
# must never reach tool commands: Codex only applies its KEY/SECRET/TOKEN filter when
# ignore_default_excludes is false, so it is set explicitly and the patterns are listed too.
# Proxy variables are withheld as well: only Codex itself talks to the model API, while tool
# commands see no route out, as with the upstream baseline's --network none.
[shell_environment_policy]
inherit = "all"
ignore_default_excludes = false
exclude = ["*KEY*", "*SECRET*", "*TOKEN*", "*PASSWORD*", "*CREDENTIAL*", "*PROXY*"]

[shell_environment_policy.set]
@SET@
