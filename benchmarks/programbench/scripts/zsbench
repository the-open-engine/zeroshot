#!/usr/bin/env bash
# Build the runner image and run one bench command against this host's Docker daemon.
#
#   scripts/zsbench smoke
#   scripts/zsbench run experiments/luna-xhigh-svgbob.json
#
# The OpenAI key comes from $OPENAI_API_KEY if set, otherwise from
# ~/.config/zeroshot-bench/openai.env (see push-openai-key.sh); the Anthropic key (Claude Code
# experiments) from ~/.config/zeroshot-bench/anthropic.env and the OpenRouter key (Codex on
# OpenRouter) from ~/.config/zeroshot-bench/openrouter.env. Either way a key reaches the runner as
# a read-only file mount, never as container config. Results land in ./results unless
# ZSBENCH_RESULTS_DIR is set. ZSBENCH_DETACH=1 runs the runner as a detached container named
# zsbench-runner, or ZSBENCH_RUNNER_NAME (follow it with `docker logs -f zsbench-runner`; stop it with
# `docker stop -t 1800 zsbench-runner` so running attempts are wound down and recorded).
# ZSBENCH_ALLOW_PARALLEL=1 lets `run` and `eval` start while other runners are up (give each its own
# ZSBENCH_RUNNER_NAME); evaluations then compete for CPUs, so schedule them with the host in mind.
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
image=${ZSBENCH_IMAGE:-zeroshot-programbench:local}
results=${ZSBENCH_RESULTS_DIR:-$PWD/results}
runner=${ZSBENCH_RUNNER_NAME:-zsbench-runner}
if [[ ! $runner =~ ^zsbench-runner[a-z0-9.-]*$ ]]; then
  echo "ZSBENCH_RUNNER_NAME must start with zsbench-runner and use lowercase letters, digits, dots and dashes" >&2
  exit 1
fi
secret=${ZSBENCH_SECRET_FILE:-$HOME/.config/zeroshot-bench/openai.env}
socket=${ZSBENCH_DOCKER_SOCK:-/var/run/docker.sock}
mkdir -p "$results"

# Provenance: the exact commit, and whether the benchmark tree differs from it.
if ref=$(git -C "$here" rev-parse HEAD 2>/dev/null); then
  if [[ -n $(git -C "$here" status --porcelain -- . | grep -v ' results/' || true) ]]; then dirty=true; else dirty=false; fi
else
  ref=unknown dirty=unknown
fi
paid_run=false
for arg in "$@"; do [[ $arg == run ]] && paid_run=true; done
if [[ $paid_run == true && $dirty != false && ${ZSBENCH_ALLOW_DIRTY:-0} != 1 ]]; then
  echo "Refusing a paid run from a tree that is not a clean git checkout (commit $ref, dirty=$dirty)." >&2
  echo "Commit or stash your changes, or set ZSBENCH_ALLOW_DIRTY=1 to override." >&2
  exit 1
fi

docker build --quiet --build-arg "VCS_REF=$ref" -t "$image" "$here" >/dev/null

args=(
  -v "$socket:/var/run/docker.sock"
  -v "$results:/results"
  -v zsbench-cache:/cache
  -v zsbench-hf:/root/.cache/huggingface
  -e "ZSBENCH_VCS_REF=$ref" -e "ZSBENCH_VCS_DIRTY=$dirty"
  -e "ZSBENCH_HOST_UID=$(id -u)" -e "ZSBENCH_HOST_GID=$(id -g)"
)
if [[ ${ZSBENCH_ALLOW_PARALLEL:-0} == 1 ]]; then
  args+=(-e "ZSBENCH_ALLOW_PARALLEL=1")
fi
# How many archives an evaluation scores at once (default: the experiment's eval.workers). Each
# archive still runs in its own containers with eval.docker_cpus, so the scores do not change.
if [[ -n ${ZSBENCH_EVAL_WORKERS:-} ]]; then
  [[ $ZSBENCH_EVAL_WORKERS =~ ^[1-9][0-9]?$ ]] || { echo "ZSBENCH_EVAL_WORKERS must be 1 to 99" >&2; exit 1; }
  args+=(-e "ZSBENCH_EVAL_WORKERS=$ZSBENCH_EVAL_WORKERS")
fi

temp_secret=""
cleanup() { if [[ -n $temp_secret ]]; then rm -f "$temp_secret"; fi; }
trap cleanup EXIT
if [[ -n ${OPENAI_API_KEY:-} ]]; then
  echo "zsbench: using OPENAI_API_KEY from the environment" >&2
  temp_secret=$(umask 077 && mktemp "${XDG_RUNTIME_DIR:-/tmp}/zsbench-key.XXXXXX")
  printf 'OPENAI_API_KEY=%s\n' "$OPENAI_API_KEY" > "$temp_secret"
  args+=(-v "$temp_secret:/run/secrets/openai.env:ro")
elif [[ -f $secret ]]; then
  echo "zsbench: using key file $secret" >&2
  args+=(-v "$secret:/run/secrets/openai.env:ro")
fi
# Claude Code experiments: the Anthropic key, for the model gateway (never the agent container).
anthropic_secret=${ZSBENCH_ANTHROPIC_SECRET_FILE:-$HOME/.config/zeroshot-bench/anthropic.env}
if [[ -f $anthropic_secret ]]; then
  echo "zsbench: using key file $anthropic_secret" >&2
  args+=(-v "$anthropic_secret:/run/secrets/anthropic.env:ro")
fi
openrouter_secret=${ZSBENCH_OPENROUTER_SECRET_FILE:-$HOME/.config/zeroshot-bench/openrouter.env}
if [[ -f $openrouter_secret ]]; then
  echo "zsbench: using key file $openrouter_secret" >&2
  args+=(-v "$openrouter_secret:/run/secrets/openrouter.env:ro")
fi

if [[ ${ZSBENCH_DETACH:-0} == 1 ]]; then
  if [[ $(docker inspect -f '{{.State.Running}}' "$runner" 2>/dev/null || true) == true ]]; then
    echo "A $runner container is already running; stop it first (docker stop -t 1800 $runner)." >&2
    exit 1
  fi
  docker rm "$runner" >/dev/null 2>&1 || true
  docker run -d --init --name "$runner" --label zsbench=1 --label zsbench.runner=1 --stop-timeout 1800 "${args[@]}" "$image" "$@"
  if [[ -n $temp_secret ]]; then
    sleep 20  # the runner reads the key at startup; the temporary file is then removed
  fi
  exit 0
fi
tty=()
[[ -t 0 ]] && tty=(-it)
docker run --rm --init --label zsbench.runner=1 "${tty[@]}" "${args[@]}" "$image" "$@"
